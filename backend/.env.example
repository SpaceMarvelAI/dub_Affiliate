# Postgres (local dev: `docker compose up -d` in this directory, host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dub_affiliate_api"

# Server
PORT=8787
FRONTEND_URL=http://localhost:5173

# Session cookie JWT signing secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# SpaceMarvel OIDC login (the only login method)
# Register an Application for this app in the SpaceMarvel dashboard's Django
# admin (/admin/oauth2_provider/application/add/), redirect_uri must match
# OIDC_REDIRECT_URI below.
OIDC_ISSUER=https://dashboard-api-dev.spacemarvel.ai/o
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8787/api/auth/callback

# Server-to-server secret for POST /api/track/sale (called by
# spacemarvel_dashboard's payment webhook)
TRACK_API_SECRET=
